\section{Findings — Round 1: Static Code Analysis (April 5)}
% =====================================================================

% --- CRITICAL ---
\subsection{CRITICAL Findings}

\begin{tcolorbox}[colback=critical!5, colframe=critical, title=\textbf{F-01: DEBUG Mode Enabled by Default}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{critical}{CRITICAL} \\
\textbf{CWE:} & CWE-489 (Active Debug Code) \\
\textbf{Location:} & \texttt{backend/app/config.py:38} \\
\textbf{CVSS:} & 7.5 (High) \\
\end{tabularx}

\textbf{Description:} The \texttt{DEBUG} configuration defaults to \texttt{True}. When active, SQLAlchemy echoes all SQL queries (including sensitive data) to stdout/logs via \texttt{echo=settings.DEBUG} in \texttt{database.py}.

\textbf{Evidence:}
\begin{verbatim}
DEBUG: bool = True  # config.py
engine = create_async_engine(settings.DATABASE_URL, echo=settings.DEBUG)
\end{verbatim}

\textbf{Impact:} SQL statements containing user data, password hashes, and encryption keys are written to logs. If logs are accessible, this constitutes a data breach.

\textbf{Remediation:} Changed default to \texttt{DEBUG: bool = False}. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=critical!5, colframe=critical, title=\textbf{F-02: Encryption Key Logged to Console}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{critical}{CRITICAL} \\
\textbf{CWE:} & CWE-532 (Insertion of Sensitive Info into Log) \\
\textbf{Location:} & \texttt{backend/app/main.py:69} \\
\textbf{CVSS:} & 9.1 (Critical) \\
\end{tabularx}

\textbf{Description:} When a new Fernet encryption key is auto-generated at startup, the key was logged at WARNING level in plaintext. This key encrypts all resumes and sensitive data at rest.

\textbf{Impact:} Master encryption key visible in log files enables decryption of all encrypted data.

\textbf{Remediation:} Removed the key value from the log message. Logs only a generic warning. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=critical!5, colframe=critical, title=\textbf{F-03: Hardcoded Default JWT Secret}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{critical}{CRITICAL} \\
\textbf{CWE:} & CWE-798 (Use of Hardcoded Credentials) \\
\textbf{Location:} & \texttt{backend/app/config.py:17} \\
\textbf{CVSS:} & 9.8 (Critical) \\
\end{tabularx}

\textbf{Description:} JWT signing key defaults to \texttt{"change-this-in-production"}. Missing \texttt{.env} enables full token forgery.

\textbf{Remediation:} Strong random key configured in \texttt{.env}. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=critical!5, colframe=critical, title=\textbf{F-04: Hardcoded Admin Credentials in Source}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{critical}{CRITICAL} \\
\textbf{CWE:} & CWE-798 (Use of Hardcoded Credentials) \\
\textbf{Location:} & \texttt{backend/seed\_admin.py:22--24} \\
\textbf{CVSS:} & 8.6 (High) \\
\end{tabularx}

\textbf{Description:} Admin seed script contains hardcoded admin email and password in source code.

\textbf{Remediation:} Password changed; seed script should read from environment variables. \textcolor{orange}{\textbf{MITIGATED}}
\end{tcolorbox}

% --- HIGH ---
\subsection{HIGH Findings}

\begin{tcolorbox}[colback=high!5, colframe=high, title=\textbf{F-05: Missing Magic Bytes Validation — Resume Upload}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{high}{HIGH} \\
\textbf{CWE:} & CWE-434 (Unrestricted Upload of Dangerous File) \\
\textbf{Location:} & \texttt{backend/app/services/resume\_service.py:37--38} \\
\textbf{CVSS:} & 7.2 (High) \\
\end{tabularx}

\textbf{Description:} Resume upload relied solely on client-controlled \texttt{content\_type}. Malicious executables could be uploaded with a spoofed MIME type.

\textbf{Remediation:} Server-side magic bytes validation: PDFs (\texttt{\%PDF}), DOCX (\texttt{PK}). \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=high!5, colframe=high, title=\textbf{F-06: Missing Magic Bytes Validation — Profile Picture}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{high}{HIGH} \\
\textbf{CWE:} & CWE-434 (Unrestricted Upload of Dangerous File) \\
\textbf{Location:} & \texttt{backend/app/routes/users.py:254} \\
\textbf{CVSS:} & 7.2 (High) \\
\end{tabularx}

\textbf{Description:} Profile picture upload validated only \texttt{content\_type}. Enabled XSS payload upload as \texttt{image/jpeg}.

\textbf{Remediation:} Magic bytes validation for JPEG, PNG, GIF, WebP + file extension allowlist. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=high!5, colframe=high, title=\textbf{F-07: Path Traversal in Profile Picture Serving}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{high}{HIGH} \\
\textbf{CWE:} & CWE-22 (Path Traversal) \\
\textbf{Location:} & \texttt{backend/app/routes/users.py:294} \\
\textbf{CVSS:} & 7.5 (High) \\
\end{tabularx}

\textbf{Description:} Avatar endpoint accepted arbitrary filename, enabling \texttt{../../../etc/passwd} traversal.

\textbf{Remediation:} Added \texttt{os.path.basename()}, \texttt{..} rejection, \texttt{os.path.realpath()} containment. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=high!5, colframe=high, title=\textbf{F-08: Weak JWT Secret in Production .env}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{high}{HIGH} \\
\textbf{CWE:} & CWE-326 (Inadequate Encryption Strength) \\
\textbf{Location:} & \texttt{backend/.env} \\
\textbf{CVSS:} & 7.4 (High) \\
\end{tabularx}

\textbf{Description:} JWT secret was a predictable dictionary-style string.

\textbf{Remediation:} Replaced with cryptographically random 256-bit key (\texttt{secrets.token\_urlsafe(32)}). \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=high!5, colframe=high, title=\textbf{F-09: TOTP Secret Exposed in Login Response}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{high}{HIGH} \\
\textbf{CWE:} & CWE-200 (Exposure of Sensitive Information) \\
\textbf{Location:} & \texttt{backend/app/routes/auth.py:218--222} \\
\textbf{CVSS:} & 6.5 (Medium) \\
\end{tabularx}

\textbf{Description:} Raw TOTP secret returned in login API response. Intercepted response enables 2FA cloning.

\textbf{Remediation:} TOTP secret removed from login response. Only QR code image during initial setup. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=high!5, colframe=high, title=\textbf{F-10: TOTP Secret Stored in Plaintext in Database}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{high}{HIGH} \\
\textbf{CWE:} & CWE-312 (Cleartext Storage of Sensitive Information) \\
\textbf{Location:} & \texttt{backend/app/models/user.py:34} \\
\textbf{CVSS:} & 6.8 (Medium) \\
\end{tabularx}

\textbf{Description:} TOTP secrets stored as raw Base32 text. Database breach exposes all 2FA secrets.

\textbf{Remediation:} Encrypted with Fernet (AES-128-CBC + HMAC-SHA256). Backward-compatible decryption for legacy values. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=high!5, colframe=high, title=\textbf{F-11: Server Private Key Without Passphrase}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{high}{HIGH} \\
\textbf{CWE:} & CWE-311 (Missing Encryption of Sensitive Data) \\
\textbf{Location:} & \texttt{backend/app/services/pki\_service.py:31--35} \\
\textbf{CVSS:} & 5.5 (Medium) \\
\end{tabularx}

\textbf{Description:} RSA private keys serialized with \texttt{NoEncryption()} — unprotected on disk.

\textbf{Remediation:} \texttt{BestAvailableEncryption} with passphrase from environment. File permissions set to 600. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=high!5, colframe=high, title=\textbf{F-12: .env File World-Readable}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{high}{HIGH} \\
\textbf{CWE:} & CWE-276 (Incorrect Default Permissions) \\
\textbf{Location:} & \texttt{backend/.env} \\
\textbf{CVSS:} & 6.2 (Medium) \\
\end{tabularx}

\textbf{Description:} .env file had 664 permissions — all system users could read secrets.

\textbf{Remediation:} Changed to \texttt{600} (owner-only). \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

% --- MEDIUM ---
\subsection{MEDIUM Findings}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-13: CORS Allows All Methods and Headers}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-942 (Overly Permissive CORS Policy) \\
\textbf{Location:} & \texttt{backend/app/main.py:107--112} \\
\end{tabularx}

\textbf{Description:} \texttt{allow\_methods=["*"]} and \texttt{allow\_headers=["*"]} permitted arbitrary methods/headers.

\textbf{Remediation:} Restricted to specific methods and headers. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-14: CSP Allows unsafe-inline for Scripts}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-79 (Cross-site Scripting) \\
\textbf{Location:} & \texttt{backend/app/middleware/security.py:20--27} \\
\end{tabularx}

\textbf{Description:} \texttt{script-src 'self' 'unsafe-inline'} weakened XSS protection.

\textbf{Remediation:} Removed \texttt{'unsafe-inline'} from \texttt{script-src}. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-15: Profile Picture Endpoint No Authentication}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-306 (Missing Authentication) \\
\textbf{Location:} & \texttt{backend/app/routes/users.py:289} \\
\end{tabularx}

\textbf{Description:} Avatar serving requires no auth. Risk reduced after path traversal fix.

\textbf{Remediation:} Profile pictures are public on a networking platform. \textcolor{orange}{\textbf{ACCEPTED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-16: In-Memory Rate Limiter Without Cleanup}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-770 (Allocation of Resources Without Limits) \\
\textbf{Location:} & \texttt{backend/app/middleware/security.py:58--93} \\
\end{tabularx}

\textbf{Description:} Rate limiter dict lacked periodic cleanup; could grow unbounded under distributed attacks.

\textbf{Remediation:} Added periodic cleanup (every 60 seconds) + stricter auth endpoint limits. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-17: Cookie Secure Flag Based on Runtime Detection}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-614 (Sensitive Cookie Without Secure Flag) \\
\textbf{Location:} & \texttt{backend/app/routes/auth.py:46--54} \\
\end{tabularx}

\textbf{Description:} \texttt{secure} flag determined at runtime — potential for downgrade.

\textbf{Remediation:} Hardcoded \texttt{secure=True} (always HTTPS via Nginx). \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-18: IP Binding Relies on Spoofable Headers}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-290 (Authentication Bypass by Spoofing) \\
\textbf{Location:} & \texttt{backend/app/utils/ip.py:16--22} \\
\end{tabularx}

\textbf{Description:} \texttt{get\_client\_ip()} trusts proxy headers unconditionally.

\textbf{Remediation:} Nginx is only entry point and sets headers correctly. Backend on localhost only. \textcolor{orange}{\textbf{ACCEPTED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-19: Swagger/ReDoc Always Enabled}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-200 (Exposure of Sensitive Information) \\
\textbf{Location:} & \texttt{backend/app/main.py:86--99} \\
\end{tabularx}

\textbf{Description:} API documentation exposed regardless of environment.

\textbf{Remediation:} Gated behind \texttt{DEBUG} flag; disabled in production. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-20: No JWT Token Revocation}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-613 (Insufficient Session Expiration) \\
\textbf{Location:} & \texttt{backend/app/services/auth\_service.py:42--48} \\
\end{tabularx}

\textbf{Description:} No token blocklist — tokens valid until natural expiry.

\textbf{Remediation:} DB-backed blocklist with in-memory cache. Revocation on logout, refresh, and password change. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-21: Verbose Error Messages to Client}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-209 (Error Message Information Leak) \\
\textbf{Location:} & \texttt{backend/app/routes/resumes.py:52--53} \\
\end{tabularx}

\textbf{Description:} \texttt{ValueError} messages forwarded to client via \texttt{str(e)}.

\textbf{Remediation:} Current messages are controlled and safe. Pattern noted. \textcolor{orange}{\textbf{NOTED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-22: Content-Disposition Header Injection}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-113 (HTTP Response Splitting) \\
\textbf{Location:} & \texttt{backend/app/routes/resumes.py:180} \\
\end{tabularx}

\textbf{Description:} Original filename used in Content-Disposition without sanitization. Special characters enable header injection.

\textbf{Remediation:} Sanitized \texttt{"}, \texttt{;}, \texttt{\textbackslash r}, \texttt{\textbackslash n} from filenames. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

% --- LOW ---
\subsection{LOW Findings}

\begin{tcolorbox}[colback=low!5, colframe=low, title=\textbf{F-23: Nginx Server Version Exposed}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{low}{LOW} \\
\textbf{CWE:} & CWE-200 (Information Exposure) \\
\textbf{Location:} & \texttt{nginx/nginx.conf} \\
\end{tabularx}
\textbf{Remediation:} \texttt{server\_tokens off}. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=low!5, colframe=low, title=\textbf{F-24: Application Version in Root Endpoint}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{low}{LOW} \\
\textbf{CWE:} & CWE-200 (Information Exposure) \\
\textbf{Location:} & \texttt{backend/app/main.py:143--149} \\
\end{tabularx}
\textbf{Remediation:} Version removed from root response. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=low!5, colframe=low, title=\textbf{F-25: RSA 2048-bit Key Size}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{low}{LOW} \\
\textbf{CWE:} & CWE-326 (Inadequate Encryption Strength) \\
\textbf{Location:} & \texttt{frontend/src/utils/e2eeKeyStore.js}, \texttt{pki\_service.py} \\
\end{tabularx}
\textbf{Remediation:} Upgraded to 4096-bit RSA keys. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=low!5, colframe=low, title=\textbf{F-26: PKCS1v15 Padding for Signatures}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{low}{LOW} \\
\textbf{CWE:} & CWE-327 (Use of Broken Crypto Algorithm) \\
\textbf{Location:} & \texttt{pki\_service.py:56--58} \\
\end{tabularx}
\textbf{Remediation:} PKCS1v15 acceptable; PSS migration recommended future. \textcolor{orange}{\textbf{NOTED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=low!5, colframe=low, title=\textbf{F-27: Private Key in sessionStorage}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{low}{LOW} \\
\textbf{CWE:} & CWE-922 (Insecure Storage of Sensitive Information) \\
\textbf{Location:} & \texttt{frontend/src/utils/e2eeKeyStore.js:168--173} \\
\end{tabularx}
\textbf{Remediation:} Mitigated by CSP hardening. Key in session memory only, cleared on tab close. \textcolor{orange}{\textbf{MITIGATED}}
\end{tcolorbox}

