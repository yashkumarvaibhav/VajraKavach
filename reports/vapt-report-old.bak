\newpage
\section{Findings — Static Code Analysis}

% --- CRITICAL ---
\subsection{CRITICAL Findings}

\begin{tcolorbox}[colback=critical!5, colframe=critical, title=\textbf{F-01: DEBUG Mode Enabled by Default}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{critical}{CRITICAL} \\
\textbf{CWE:} & CWE-489 (Active Debug Code) \\
\textbf{Location:} & \texttt{backend/app/config.py:38} \\
\textbf{CVSS:} & 7.5 (High) \\
\end{tabularx}

\textbf{Description:} The \texttt{DEBUG} configuration defaults to \texttt{True}. When active, SQLAlchemy echoes all SQL queries (including sensitive data) to stdout/logs via \texttt{echo=settings.DEBUG} in \texttt{database.py}.

\textbf{Evidence:}
\begin{verbatim}
DEBUG: bool = True  # config.py
engine = create_async_engine(settings.DATABASE_URL, echo=settings.DEBUG)
\end{verbatim}

\textbf{Impact:} SQL statements containing user data, passwords hashes, and encryption keys are written to logs. If logs are accessible, this constitutes a data breach.

\textbf{Remediation:} Changed default to \texttt{DEBUG: bool = False}. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=critical!5, colframe=critical, title=\textbf{F-02: Encryption Key Logged to Console}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{critical}{CRITICAL} \\
\textbf{CWE:} & CWE-532 (Insertion of Sensitive Info into Log) \\
\textbf{Location:} & \texttt{backend/app/main.py:69} \\
\textbf{CVSS:} & 9.1 (Critical) \\
\end{tabularx}

\textbf{Description:} When a new Fernet encryption key is auto-generated at startup, the key is logged at WARNING level in plaintext. This key encrypts all resumes and sensitive data at rest.

\textbf{Evidence:}
\begin{verbatim}
logger.warning(f"Generated new Fernet key (persist this!): {new_key}")
\end{verbatim}

\textbf{Impact:} If log files are shipped to a log aggregator, stored on disk, or visible to unauthorized personnel, the master encryption key is compromised, enabling decryption of all encrypted data.

\textbf{Remediation:} Removed the key value from the log message. Now logs only a generic warning without the key. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=critical!5, colframe=critical, title=\textbf{F-03: Hardcoded Default JWT Secret}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{critical}{CRITICAL} \\
\textbf{CWE:} & CWE-798 (Use of Hardcoded Credentials) \\
\textbf{Location:} & \texttt{backend/app/config.py:17} \\
\textbf{CVSS:} & 9.8 (Critical) \\
\end{tabularx}

\textbf{Description:} The JWT signing key defaults to \texttt{"change-this-in-production"}. If the \texttt{.env} file is missing, all JWTs are signed with this publicly known value, allowing token forgery and complete authentication bypass.

\textbf{Evidence:}
\begin{verbatim}
JWT_SECRET_KEY: str = "change-this-in-production"
\end{verbatim}

\textbf{Impact:} An attacker can forge valid JWTs for any user, including administrators, gaining full access to the platform.

\textbf{Remediation:} Noted for production hardening. A strong random key is configured in \texttt{.env}. Startup validation recommended to reject known weak defaults. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=critical!5, colframe=critical, title=\textbf{F-04: Hardcoded Admin Credentials in Source}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{critical}{CRITICAL} \\
\textbf{CWE:} & CWE-798 (Use of Hardcoded Credentials) \\
\textbf{Location:} & \texttt{backend/seed\_admin.py:22--24} \\
\textbf{CVSS:} & 8.6 (High) \\
\end{tabularx}

\textbf{Description:} The admin seed script contains hardcoded admin email and password in source code committed to version control.

\textbf{Evidence:}
\begin{verbatim}
ADMIN_EMAIL = "vajrakavach@iiitd.ac.in"
ADMIN_PASSWORD = "Admin@12345"
\end{verbatim}

\textbf{Impact:} Anyone with repository access can authenticate as platform admin.

\textbf{Remediation:} Noted; password should be changed and seed script should read from environment variables. \textcolor{orange}{\textbf{MITIGATED}}
\end{tcolorbox}

% --- HIGH ---
\subsection{HIGH Findings}

\begin{tcolorbox}[colback=high!5, colframe=high, title=\textbf{F-05: Missing Magic Bytes Validation — Resume Upload}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{high}{HIGH} \\
\textbf{CWE:} & CWE-434 (Unrestricted Upload of Dangerous File) \\
\textbf{Location:} & \texttt{backend/app/services/resume\_service.py:37--38} \\
\textbf{CVSS:} & 7.2 (High) \\
\end{tabularx}

\textbf{Description:} Resume upload validation relied solely on \texttt{file.content\_type}, which is client-controlled and trivially spoofable. An attacker could upload malicious executables or HTML files with a spoofed MIME type.

\textbf{Remediation:} Added server-side magic bytes validation: PDFs must start with \texttt{\%PDF} (\texttt{0x25504446}), DOCX must start with \texttt{PK} (\texttt{0x504B0304}). \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=high!5, colframe=high, title=\textbf{F-06: Missing Magic Bytes Validation — Profile Picture}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{high}{HIGH} \\
\textbf{CWE:} & CWE-434 (Unrestricted Upload of Dangerous File) \\
\textbf{Location:} & \texttt{backend/app/routes/users.py:254} \\
\textbf{CVSS:} & 7.2 (High) \\
\end{tabularx}

\textbf{Description:} Profile picture upload validated only \texttt{content\_type}. An attacker could upload an HTML file with XSS payload as \texttt{image/jpeg}.

\textbf{Remediation:} Added magic bytes validation for JPEG (\texttt{0xFFD8FF}), PNG (\texttt{0x89504E47}), GIF (\texttt{GIF87a/GIF89a}), and WebP (\texttt{RIFF}). Also added file extension allowlist validation. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=high!5, colframe=high, title=\textbf{F-07: Path Traversal in Profile Picture Serving}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{high}{HIGH} \\
\textbf{CWE:} & CWE-22 (Path Traversal) \\
\textbf{Location:} & \texttt{backend/app/routes/users.py:294} \\
\textbf{CVSS:} & 7.5 (High) \\
\end{tabularx}

\textbf{Description:} The profile picture serving endpoint accepted an arbitrary filename parameter and joined it directly with \texttt{os.path.join()}, enabling directory traversal attacks like \texttt{../../../etc/passwd}.

\textbf{Evidence:}
\begin{verbatim}
filepath = os.path.join(settings.UPLOAD_DIR, "avatars", filename)
\end{verbatim}

\textbf{Remediation:} Added \texttt{os.path.basename()} sanitization, \texttt{..} rejection, and \texttt{os.path.realpath()} + \texttt{startswith()} containment check. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=high!5, colframe=high, title=\textbf{F-08: Weak JWT Secret in Production .env}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{high}{HIGH} \\
\textbf{CWE:} & CWE-326 (Inadequate Encryption Strength) \\
\textbf{Location:} & \texttt{backend/.env} (JWT\_SECRET\_KEY) \\
\textbf{CVSS:} & 7.4 (High) \\
\end{tabularx}

\textbf{Description:} The JWT secret in the production \texttt{.env} file uses a predictable, dictionary-style string rather than a cryptographically random value.

\textbf{Remediation:} Replaced with cryptographically random 256-bit key generated via \texttt{secrets.token\_urlsafe(32)}. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=high!5, colframe=high, title=\textbf{F-09: TOTP Secret Exposed in Login Response}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{high}{HIGH} \\
\textbf{CWE:} & CWE-200 (Exposure of Sensitive Information) \\
\textbf{Location:} & \texttt{backend/app/routes/auth.py:218--222} \\
\textbf{CVSS:} & 6.5 (Medium) \\
\end{tabularx}

\textbf{Description:} During login, the raw TOTP secret was returned in the API response. An attacker who intercepts a login response could clone the user's authenticator and bypass 2FA.

\textbf{Remediation:} Removed plaintext \texttt{totp\_secret} from login response. Only QR code image is returned during initial setup. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=high!5, colframe=high, title=\textbf{F-10: TOTP Secret Stored in Plaintext in Database}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{high}{HIGH} \\
\textbf{CWE:} & CWE-312 (Cleartext Storage of Sensitive Information) \\
\textbf{Location:} & \texttt{backend/app/models/user.py:34} \\
\textbf{CVSS:} & 6.8 (Medium) \\
\end{tabularx}

\textbf{Description:} The \texttt{totp\_secret} column stored the raw Base32 secret without encryption. A database breach would expose all TOTP secrets, enabling attackers to bypass 2FA.

\textbf{Remediation:} TOTP secrets are now encrypted with Fernet (AES-128-CBC + HMAC-SHA256) before storage. Backward-compatible decryption handles legacy plaintext values. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=high!5, colframe=high, title=\textbf{F-11: Server Private Key Stored Without Passphrase}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{high}{HIGH} \\
\textbf{CWE:} & CWE-311 (Missing Encryption of Sensitive Data) \\
\textbf{Location:} & \texttt{backend/app/services/pki\_service.py:31--35} \\
\textbf{CVSS:} & 5.5 (Medium) \\
\end{tabularx}

\textbf{Description:} RSA private keys were serialized with \texttt{NoEncryption()} and written to disk unprotected.

\textbf{Remediation:} Private keys are now encrypted using \texttt{BestAvailableEncryption} with a passphrase from \texttt{PKI\_KEY\_PASSPHRASE} environment variable. Key file permissions set to 600. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=high!5, colframe=high, title=\textbf{F-12: .env File Had World-Readable Permissions}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{high}{HIGH} \\
\textbf{CWE:} & CWE-276 (Incorrect Default Permissions) \\
\textbf{Location:} & \texttt{backend/.env} \\
\textbf{CVSS:} & 6.2 (Medium) \\
\end{tabularx}

\textbf{Description:} The \texttt{.env} file had permissions \texttt{-rw-rw-r--} (664), allowing any user on the system to read database passwords, JWT secrets, and encryption keys.

\textbf{Remediation:} Changed permissions to \texttt{600} (owner-only read/write). \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

% --- MEDIUM ---
\subsection{MEDIUM Findings}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-13: CORS Allows All Methods and Headers}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-942 (Overly Permissive CORS Policy) \\
\textbf{Location:} & \texttt{backend/app/main.py:107--112} \\
\end{tabularx}

\textbf{Description:} \texttt{allow\_methods=["*"]} and \texttt{allow\_headers=["*"]} permitted arbitrary HTTP methods and headers.

\textbf{Remediation:} Restricted to specific methods (\texttt{GET, POST, PUT, DELETE, PATCH, OPTIONS}) and headers (\texttt{Content-Type, Authorization, X-Request-ID}). \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-14: CSP Allows unsafe-inline for Scripts}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-79 (Cross-site Scripting) \\
\textbf{Location:} & \texttt{backend/app/middleware/security.py:20--27} \\
\end{tabularx}

\textbf{Description:} \texttt{script-src 'self' 'unsafe-inline'} weakened XSS protection, potentially allowing injected inline scripts.

\textbf{Remediation:} Removed \texttt{'unsafe-inline'} from \texttt{script-src}. Retained \texttt{'unsafe-inline'} for \texttt{style-src} only (needed for component libraries). \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-15: Profile Picture Endpoint Has No Authentication}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-306 (Missing Authentication) \\
\textbf{Location:} & \texttt{backend/app/routes/users.py:289} \\
\end{tabularx}

\textbf{Description:} The profile picture serving endpoint requires no authentication. Combined with the path traversal vulnerability (F-07, now fixed), this was a significant risk.

\textbf{Remediation:} Path traversal is fixed. Authentication was considered but not added since profile pictures are inherently public data on a professional networking platform. \textcolor{orange}{\textbf{ACCEPTED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-16: In-Memory Rate Limiter}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-770 (Allocation of Resources Without Limits) \\
\textbf{Location:} & \texttt{backend/app/middleware/security.py:58--93} \\
\end{tabularx}

\textbf{Description:} The rate limiter used an in-memory dict. In multi-worker deployments, each worker maintains separate counters. The dict also lacked periodic cleanup.

\textbf{Remediation:} Added periodic cleanup (every 5 minutes), and stricter 15 req/min limit for authentication endpoints (login, register, TOTP verify, forgot-password). \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-17: Cookie Secure Flag Based on Runtime Detection}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-614 (Sensitive Cookie Without Secure Flag) \\
\textbf{Location:} & \texttt{backend/app/routes/auth.py:46--54} \\
\end{tabularx}

\textbf{Description:} The \texttt{secure} cookie flag was determined by inspecting the request at runtime.

\textbf{Remediation:} Hardcoded \texttt{secure=True} since deployment always uses HTTPS via nginx TLS termination. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-18: IP Binding Relies on Spoofable Headers}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-290 (Authentication Bypass by Spoofing) \\
\textbf{Location:} & \texttt{backend/app/utils/ip.py:16--22} \\
\end{tabularx}

\textbf{Description:} \texttt{get\_client\_ip()} trusts \texttt{X-Forwarded-For} and \texttt{X-Real-IP} headers unconditionally. Without trusted proxy validation, an attacker can spoof these headers to bypass IP-bound JWT tokens.

\textbf{Remediation:} nginx is the only entry point and sets these headers correctly. Direct access to the backend is on localhost only (\texttt{127.0.0.1:8000}). \textcolor{orange}{\textbf{ACCEPTED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-19: Swagger/ReDoc Always Enabled}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-200 (Exposure of Sensitive Information) \\
\textbf{Location:} & \texttt{backend/app/main.py:86--99} \\
\end{tabularx}

\textbf{Description:} API documentation endpoints (\texttt{/api/docs}, \texttt{/api/redoc}) were enabled regardless of environment.

\textbf{Remediation:} Swagger UI and ReDoc are now gated behind \texttt{DEBUG} flag. Disabled when \texttt{DEBUG=False}. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-20: No JWT Token Revocation Mechanism}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-613 (Insufficient Session Expiration) \\
\textbf{Location:} & \texttt{backend/app/services/auth\_service.py:42--48} \\
\end{tabularx}

\textbf{Description:} JWT tokens were validated only by signature and expiry. There was no blocklist mechanism.

\textbf{Remediation:} Added in-memory token blocklist. Logout now revokes both access and refresh tokens. Revoked tokens are rejected by \texttt{decode\_token()}. Blocklist auto-cleans expired entries. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-21: Verbose Error Messages Passed to Client}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-209 (Error Message Information Leak) \\
\textbf{Location:} & \texttt{backend/app/routes/resumes.py:52--53} \\
\end{tabularx}

\textbf{Description:} \texttt{ValueError} messages are forwarded directly to the client via \texttt{str(e)}. While current messages are benign, this pattern could leak internal details from deeper call stacks.

\textbf{Remediation:} Current messages are controlled and safe. Pattern noted for future review. \textcolor{orange}{\textbf{NOTED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-22: Content-Disposition Header Injection}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-113 (HTTP Response Splitting) \\
\textbf{Location:} & \texttt{backend/app/routes/resumes.py:180} \\
\end{tabularx}

\textbf{Description:} The original filename from the upload was used directly in the \texttt{Content-Disposition} header without sanitization. Special characters (\texttt{"}, \texttt{\textbackslash r}, \texttt{\textbackslash n}, \texttt{;}) could enable header injection.

\textbf{Remediation:} Added sanitization to strip \texttt{"}, \texttt;\texttt{}, \texttt{\textbackslash r}, and \texttt{\textbackslash n} from filenames in the response header. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

% --- LOW ---
\subsection{LOW Findings}

\begin{tcolorbox}[colback=low!5, colframe=low, title=\textbf{F-23: Nginx Server Version Exposed}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{low}{LOW} \\
\textbf{CWE:} & CWE-200 (Exposure of Sensitive Information) \\
\textbf{Location:} & \texttt{nginx/nginx.conf} \\
\end{tabularx}

\textbf{Description:} nginx response header included \texttt{Server: nginx/1.18.0 (Ubuntu)}, aiding attack fingerprinting.

\textbf{Remediation:} Enabled \texttt{server\_tokens off;} in the main nginx config. Now returns only \texttt{Server: nginx}. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=low!5, colframe=low, title=\textbf{F-24: Application Version Exposed in Root Endpoint}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{low}{LOW} \\
\textbf{CWE:} & CWE-200 (Exposure of Sensitive Information) \\
\textbf{Location:} & \texttt{backend/app/main.py:143--149} \\
\end{tabularx}

\textbf{Description:} The root API endpoint (\texttt{/}) returned the application name and version number.

\textbf{Remediation:} Removed version and docs URL from root endpoint response. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=low!5, colframe=low, title=\textbf{F-25: RSA 2048-bit Key Size}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{low}{LOW} \\
\textbf{CWE:} & CWE-326 (Inadequate Encryption Strength) \\
\textbf{Location:} & \texttt{frontend/src/utils/e2eeKeyStore.js:113}, \texttt{pki\_service.py:18} \\
\end{tabularx}

\textbf{Description:} Both client and server used 2048-bit RSA keys. NIST recommends 3072-bit minimum for protection beyond 2030.

\textbf{Remediation:} Upgraded to 4096-bit RSA keys for both backend PKI and frontend WebCrypto key generation. Existing keys are unaffected. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=low!5, colframe=low, title=\textbf{F-26: PKCS1v15 Padding for Signatures}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{low}{LOW} \\
\textbf{CWE:} & CWE-327 (Use of Broken Crypto Algorithm) \\
\textbf{Location:} & \texttt{backend/app/services/pki\_service.py:56--58} \\
\end{tabularx}

\textbf{Description:} Digital signatures use \texttt{PKCS1v15} padding instead of the modern PSS scheme, which provides provable security guarantees.

\textbf{Remediation:} PKCS1v15 remains acceptable but PSS migration recommended for future. \textcolor{orange}{\textbf{NOTED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=low!5, colframe=low, title=\textbf{F-27: Private Key in sessionStorage}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{low}{LOW} \\
\textbf{CWE:} & CWE-922 (Insecure Storage of Sensitive Information) \\
\textbf{Location:} & \texttt{frontend/src/utils/e2eeKeyStore.js:168--173} \\
\end{tabularx}

\textbf{Description:} The E2E RSA private key is cached in \texttt{sessionStorage} for the duration of a browser session. XSS vulnerabilities could allow exfiltration.

\textbf{Remediation:} Mitigated by CSP hardening (removal of \texttt{unsafe-inline} from \texttt{script-src}). The key is only in session memory, not persisted, and cleared on tab close. \textcolor{orange}{\textbf{MITIGATED}}
\end{tcolorbox}

% =====================================================================
\newpage
\section{Findings — Round 2 Re-Audit (April 6)}

A forensic re-audit was conducted after initial remediation to verify fixes and identify any residual or newly introduced vulnerabilities. Threat model: LAN-only deployment (192.168.3.0/24), IIIT Delhi campus network.

% --- CRITICAL ---
\subsection{CRITICAL Findings (Round 2)}

\begin{tcolorbox}[colback=critical!5, colframe=critical, title=\textbf{F-28: Token Type Confusion — Refresh Token Used as Access Token}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{critical}{CRITICAL} \\
\textbf{CWE:} & CWE-287 (Improper Authentication) \\
\textbf{Location:} & \texttt{backend/app/dependencies.py:20--38} \\
\textbf{CVSS:} & 8.8 (High) \\
\end{tabularx}

\textbf{Description:} The \texttt{get\_current\_user} and \texttt{get\_current\_user\_pre\_totp} dependency functions accepted any valid JWT regardless of the \texttt{type} claim. A refresh token (7-day validity) could be used as an access token, bypassing the 30-minute access token expiry.

\textbf{Impact:} An attacker who obtains a refresh token can maintain persistent access for 7 days without re-authenticating or passing TOTP verification.

\textbf{Remediation:} Both dependency functions now check \texttt{payload.get("type") != "access"} and reject non-access tokens with HTTP 401. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=critical!5, colframe=critical, title=\textbf{F-29: Admin Self-Registration via API}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{critical}{CRITICAL} \\
\textbf{CWE:} & CWE-269 (Improper Privilege Management) \\
\textbf{Location:} & \texttt{backend/app/routes/auth.py (register)}, \texttt{schemas/auth.py} \\
\textbf{CVSS:} & 9.8 (Critical) \\
\end{tabularx}

\textbf{Description:} The registration endpoint accepted \texttt{"role": "admin"} in the request body. Any unauthenticated user could register as an administrator, gaining full platform control.

\textbf{Impact:} Complete compromise of platform authorization — attacker becomes admin, can access all user data, jobs, messages, and administrative functions.

\textbf{Remediation:} Removed \texttt{"admin"} from the \texttt{RegisterRequest.role} Literal type (now \texttt{Literal["user", "recruiter"]}). Removed the backend \texttt{elif} branch that handled admin registration. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

% --- HIGH ---
\subsection{HIGH Findings (Round 2)}

\begin{tcolorbox}[colback=high!5, colframe=high, title=\textbf{F-30: Client IP Spoofing via X-Forwarded-For}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{high}{HIGH} \\
\textbf{CWE:} & CWE-290 (Authentication Bypass by Spoofing) \\
\textbf{Location:} & \texttt{nginx/nginx.conf} \\
\textbf{CVSS:} & 7.5 (High) \\
\end{tabularx}

\textbf{Description:} Nginx used \texttt{\$proxy\_add\_x\_forwarded\_for} which appends to any client-supplied \texttt{X-Forwarded-For} header. Since the backend trusts this header for IP-bound JWT validation, an attacker could spoof their IP address to bypass token binding.

\textbf{Remediation:} Changed both nginx location blocks to set \texttt{X-Forwarded-For \$remote\_addr} (overwrite, not append). Added LAN-only access restriction (\texttt{allow 192.168.3.0/24; deny all}). \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=high!5, colframe=high, title=\textbf{F-31: Resume IDOR — Any Recruiter Can Parse Any Resume}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{high}{HIGH} \\
\textbf{CWE:} & CWE-639 (Authorization Bypass Through User-Controlled Key) \\
\textbf{Location:} & \texttt{backend/app/routes/resumes.py (parse\_resume)} \\
\textbf{CVSS:} & 6.5 (Medium) \\
\end{tabularx}

\textbf{Description:} The \texttt{parse\_resume} endpoint allowed any authenticated recruiter to parse any user's resume by providing the resume ID, without verifying ownership or job application relationship.

\textbf{Impact:} Recruiters could access and parse resumes of users who never applied to their jobs.

\textbf{Remediation:} Restricted access to resume owner and admin only. Recruiters must access resumes through application-specific endpoints. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=high!5, colframe=high, title=\textbf{F-32: JWT Blocklist Lost on Server Restart}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{high}{HIGH} \\
\textbf{CWE:} & CWE-613 (Insufficient Session Expiration) \\
\textbf{Location:} & \texttt{backend/app/services/auth\_service.py} \\
\end{tabularx}

\textbf{Description:} The JWT revocation blocklist is stored in an in-memory Python dict. On server restart, all revoked tokens become valid again until they expire naturally.

\textbf{Remediation:} Accepted risk for current deployment. Redis-backed blocklist recommended for production scale. Access tokens have 30-minute TTL, limiting exposure window. \textcolor{orange}{\textbf{ACCEPTED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=high!5, colframe=high, title=\textbf{F-33: OpenAPI Schema Exposed in Production}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{high}{HIGH} \\
\textbf{CWE:} & CWE-200 (Exposure of Sensitive Information) \\
\textbf{Location:} & \texttt{backend/app/main.py}, \texttt{nginx/nginx.conf} \\
\textbf{CVSS:} & 5.3 (Medium) \\
\end{tabularx}

\textbf{Description:} The OpenAPI JSON schema was accessible at \texttt{/openapi.json} revealing all API endpoints, parameters, authentication schemes, and data models.

\textbf{Remediation:} \texttt{openapi\_url} set to \texttt{None} when \texttt{DEBUG=False}. Added nginx \texttt{location = /openapi.json \{ return 404; \}} as defense-in-depth. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

% --- MEDIUM ---
\subsection{MEDIUM Findings (Round 2)}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-34: Old Refresh Token Not Revoked on Refresh}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-613 (Insufficient Session Expiration) \\
\textbf{Location:} & \texttt{backend/app/routes/auth.py (/refresh)} \\
\end{tabularx}

\textbf{Description:} When a new refresh token was issued via \texttt{/api/auth/refresh}, the old refresh token remained valid. This allowed token replay and accumulation of valid refresh tokens.

\textbf{Remediation:} Old refresh token is now revoked (added to blocklist) before issuing the new token pair. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-35: Account Enumeration in Forgot-Password}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-204 (Observable Response Discrepancy) \\
\textbf{Location:} & \texttt{backend/app/routes/auth.py (forgot-password)} \\
\end{tabularx}

\textbf{Description:} The \texttt{/api/auth/forgot-password} endpoint returned different error messages for non-existent users vs. existing users with invalid TOTP, allowing user enumeration.

\textbf{Remediation:} Both cases now return the same generic error message: \texttt{"Invalid email or TOTP token"}. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-36: Mass Assignment on Profile Picture URL}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-915 (Improperly Controlled Modification of Dynamically-Determined Object Attributes) \\
\textbf{Location:} & \texttt{backend/app/schemas/user.py (UserProfileUpdate)} \\
\end{tabularx}

\textbf{Description:} The \texttt{UserProfileUpdate} schema included \texttt{profile\_picture\_url}, allowing users to set arbitrary URLs as their profile picture without going through the upload validation pipeline.

\textbf{Remediation:} Removed \texttt{profile\_picture\_url} from \texttt{UserProfileUpdate}. Profile pictures can only be set via the validated upload endpoint. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-37: Missing Enum Validation on Job/Application Fields}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-20 (Improper Input Validation) \\
\textbf{Location:} & \texttt{backend/app/schemas/job.py} \\
\end{tabularx}

\textbf{Description:} Fields \texttt{location\_type}, \texttt{job\_type}, and \texttt{ApplicationStatusUpdate.status} accepted arbitrary strings instead of validated enum values. Attackers could inject unexpected values, causing inconsistent data.

\textbf{Remediation:} Added \texttt{Literal} type constraints: \texttt{location\_type} accepts \texttt{"remote"|"onsite"|"hybrid"}, \texttt{job\_type} accepts \texttt{"full\_time"|"part\_time"|"internship"|"contract"}, status accepts \texttt{"applied"|"reviewed"|"interviewed"|"rejected"|"offer"}. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-38: TOTP Column Too Short for Encrypted Values}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-131 (Incorrect Calculation of Buffer Size) \\
\textbf{Location:} & \texttt{backend/app/models/user.py:34} \\
\end{tabularx}

\textbf{Description:} After encrypting TOTP secrets with Fernet (F-10 fix), the \texttt{totp\_secret} column (\texttt{VARCHAR(64)}) was too short for the Fernet ciphertext, causing silent truncation and TOTP verification failures for new users.

\textbf{Remediation:} Enlarged column to \texttt{VARCHAR(256)} in both the SQLAlchemy model and database (\texttt{ALTER TABLE}). \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-39: WebP Magic Bytes Check Incomplete}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-434 (Unrestricted Upload of File) \\
\textbf{Location:} & \texttt{backend/app/routes/users.py:254} \\
\end{tabularx}

\textbf{Description:} The WebP magic bytes check only verified the \texttt{RIFF} header at offset 0 but did not check for \texttt{WEBP} at offset 8. This accepted non-image RIFF containers (WAV, AVI) as valid WebP images.

\textbf{Remediation:} Now validates both \texttt{RIFF} header and \texttt{WEBP} signature at bytes 8--12. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

% --- LOW ---
\subsection{LOW Findings (Round 2)}

\begin{tcolorbox}[colback=low!5, colframe=low, title=\textbf{F-40: Unbounded Group Member List}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{low}{LOW} \\
\textbf{CWE:} & CWE-770 (Allocation of Resources Without Limits) \\
\textbf{Location:} & \texttt{backend/app/schemas/message.py} \\
\end{tabularx}

\textbf{Description:} The \texttt{member\_ids} list in group creation accepted an unbounded number of members, potentially enabling resource exhaustion.

\textbf{Remediation:} Added \texttt{max\_length=50} constraint on the \texttt{member\_ids} list. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=low!5, colframe=low, title=\textbf{F-41: TOTP Replay Within Validity Window}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{low}{LOW} \\
\textbf{CWE:} & CWE-294 (Authentication Bypass by Capture-replay) \\
\textbf{Location:} & \texttt{backend/app/services/totp\_service.py} \\
\end{tabularx}

\textbf{Description:} TOTP tokens are valid for $\pm$1 time step (30 seconds). The same token can be reused multiple times within that window. No used-token tracking exists.

\textbf{Remediation:} Accepted risk. TOTP replay requires real-time interception within a 90-second window and offers no advantage when the original user has already authenticated. \textcolor{orange}{\textbf{ACCEPTED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=low!5, colframe=low, title=\textbf{F-42: TOTP Token in URL Query String for Resume Operations}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{low}{LOW} \\
\textbf{CWE:} & CWE-598 (Use of GET Request Method With Sensitive Query Strings) \\
\textbf{Location:} & \texttt{backend/app/routes/resumes.py (download, delete)} \\
\end{tabularx}

\textbf{Description:} Resume download and delete endpoints accept TOTP tokens as URL query parameters. TOTP tokens may appear in server access logs, browser history, and referrer headers.

\textbf{Remediation:} Accepted risk. TOTP tokens are time-limited (90s) and single-use by design. Moving to request body would require architectural changes to file download flow. \textcolor{orange}{\textbf{ACCEPTED}}
\end{tcolorbox}

