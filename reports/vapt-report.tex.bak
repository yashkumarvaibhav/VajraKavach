\section{Findings — Round 2: Forensic Re-Audit (April 6)}
% =====================================================================

A forensic re-audit was conducted after initial remediation. Threat model: LAN-only (192.168.3.0/24, IIIT-Delhi campus).

\subsection{CRITICAL Findings (Round 2)}

\begin{tcolorbox}[colback=critical!5, colframe=critical, title=\textbf{F-28: Token Type Confusion — Refresh as Access Token}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{critical}{CRITICAL} \\
\textbf{CWE:} & CWE-287 (Improper Authentication) \\
\textbf{Location:} & \texttt{backend/app/dependencies.py:20--38} \\
\textbf{CVSS:} & 8.8 (High) \\
\end{tabularx}

\textbf{Description:} Auth dependencies accepted any valid JWT regardless of \texttt{type} claim. A refresh token (7-day validity) could bypass the 30-minute access token expiry.

\textbf{Impact:} Persistent 7-day access without re-authentication or TOTP verification.

\textbf{Remediation:} Added \texttt{type != "access"} check; non-access tokens rejected with 401. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=critical!5, colframe=critical, title=\textbf{F-29: Admin Self-Registration via API}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{critical}{CRITICAL} \\
\textbf{CWE:} & CWE-269 (Improper Privilege Management) \\
\textbf{Location:} & \texttt{backend/app/routes/auth.py}, \texttt{schemas/auth.py} \\
\textbf{CVSS:} & 9.8 (Critical) \\
\end{tabularx}

\textbf{Description:} Registration endpoint accepted \texttt{"role": "admin"}. Any unauthenticated user could become platform admin.

\textbf{Impact:} Complete authorization compromise.

\textbf{Remediation:} Removed "admin" from RegisterRequest role Literal. Backend admin branch removed. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\subsection{HIGH Findings (Round 2)}

\begin{tcolorbox}[colback=high!5, colframe=high, title=\textbf{F-30: Client IP Spoofing via X-Forwarded-For}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{high}{HIGH} \\
\textbf{CWE:} & CWE-290 (Authentication Bypass by Spoofing) \\
\textbf{Location:} & \texttt{nginx/nginx.conf} \\
\textbf{CVSS:} & 7.5 (High) \\
\end{tabularx}

\textbf{Description:} Nginx appended to client-supplied X-Forwarded-For instead of overwriting. Enabled IP-bound JWT bypass.

\textbf{Remediation:} Changed to \texttt{X-Forwarded-For \$remote\_addr} (overwrite). LAN-only restriction added. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=high!5, colframe=high, title=\textbf{F-31: Resume IDOR — Recruiter Can Parse Any Resume}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{high}{HIGH} \\
\textbf{CWE:} & CWE-639 (Authorization Bypass Through User-Controlled Key) \\
\textbf{Location:} & \texttt{backend/app/routes/resumes.py} \\
\textbf{CVSS:} & 6.5 (Medium) \\
\end{tabularx}

\textbf{Description:} Any recruiter could parse any user's resume by ID, regardless of job application relationship.

\textbf{Remediation:} Restricted to resume owner and admin only. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=high!5, colframe=high, title=\textbf{F-32: JWT Blocklist Lost on Restart}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{high}{HIGH} \\
\textbf{CWE:} & CWE-613 (Insufficient Session Expiration) \\
\textbf{Location:} & \texttt{backend/app/services/auth\_service.py} \\
\end{tabularx}

\textbf{Description:} Initially in-memory only blocklist. Server restart un-revoked all tokens.

\textbf{Remediation:} DB-backed persistence added. Revoked tokens survive restarts. \textcolor{green!60!black}{\textbf{FIXED}} (Updated from ACCEPTED — persistence was later implemented)
\end{tcolorbox}

\begin{tcolorbox}[colback=high!5, colframe=high, title=\textbf{F-33: OpenAPI Schema Exposed in Production}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{high}{HIGH} \\
\textbf{CWE:} & CWE-200 (Information Exposure) \\
\textbf{Location:} & \texttt{backend/app/main.py}, \texttt{nginx/nginx.conf} \\
\textbf{CVSS:} & 5.3 (Medium) \\
\end{tabularx}

\textbf{Description:} \texttt{/openapi.json} exposed all endpoints, parameters, and auth schemes.

\textbf{Remediation:} Disabled in FastAPI + blocked in Nginx (defense-in-depth). \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\subsection{MEDIUM Findings (Round 2)}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-34: Old Refresh Token Not Revoked on Refresh}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-613 (Insufficient Session Expiration) \\
\end{tabularx}
\textbf{Remediation:} Old refresh token now revoked before issuing new pair. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-35: Account Enumeration in Forgot-Password}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-204 (Observable Response Discrepancy) \\
\end{tabularx}
\textbf{Remediation:} Both cases return \texttt{"Invalid email or TOTP token"}. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-36: Mass Assignment on Profile Picture URL}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-915 (Mass Assignment) \\
\end{tabularx}
\textbf{Remediation:} Removed from update schema. Only upload endpoint sets picture. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-37: Missing Enum Validation on Job Fields}]
\begin{tabularx}{\textwidth}{lX}
\textbf{Severity:} & \textcolor{medium}{MEDIUM} \\
\textbf{CWE:} & CWE-20 (Improper Input Validation) \\
\end{tabularx}
\textbf{Remediation:} Added \texttt{Literal} type constraints for all enum fields. \textcolor{green!60!black}{\textbf{FIXED}}
\end{tcolorbox}

\begin{tcolorbox}[colback=medium!5, colframe=medium, title=\textbf{F-38: TOTP Column Too Short for Encrypted Values}]
\begin{tabularx}{\textwidth}{lX}
