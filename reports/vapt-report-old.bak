\section{Findings — Dynamic Testing}

\subsection{TLS Configuration}
\begin{tcolorbox}[colback=green!5, colframe=green!60!black, title=\textbf{PASS: TLS 1.3 with Strong Cipher Suite}]
\begin{itemize}[nosep]
  \item \textbf{Protocol:} TLSv1.3
  \item \textbf{Cipher:} TLS\_AES\_256\_GCM\_SHA384
  \item \textbf{Certificate:} Signed by local CA (mkcert), valid until July 2028
  \item \textbf{HSTS:} Present (\texttt{max-age=31536000; includeSubDomains})
\end{itemize}
\end{tcolorbox}

\subsection{CORS Validation}
\begin{tcolorbox}[colback=green!5, colframe=green!60!black, title=\textbf{PASS: CORS Origin Properly Validated}]
Tested with \texttt{Origin: https://evil.com}. The server did \textbf{not} reflect the origin in \texttt{Access-Control-Allow-Origin}. Only configured origins are accepted.
\end{tcolorbox}

\subsection{Authentication Attacks}
\begin{tcolorbox}[colback=green!5, colframe=green!60!black, title=\textbf{PASS: JWT None Algorithm Rejected}]
A forged JWT with \texttt{"alg":"none"} was correctly rejected with HTTP 401.
\end{tcolorbox}

\begin{tcolorbox}[colback=green!5, colframe=green!60!black, title=\textbf{PASS: Tampered JWT Rejected}]
A JWT with a modified payload and fake signature was correctly rejected with HTTP 401.
\end{tcolorbox}

\subsection{Rate Limiting}
\begin{tcolorbox}[colback=green!5, colframe=green!60!black, title=\textbf{PASS: Rate Limiting Functional}]
After approximately 52 rapid requests to \texttt{/api/auth/me}, the server returned HTTP 429 (\texttt{"Rate limit exceeded"}). The configured limit of 60 requests/minute is enforced. Auth-specific endpoints enforce a stricter 15 req/min limit.
\end{tcolorbox}

\subsection{Round 2 Dynamic Verification}
\begin{tcolorbox}[colback=green!5, colframe=green!60!black, title=\textbf{PASS: Admin Self-Registration Blocked}]
\texttt{POST /api/auth/register} with \texttt{"role": "admin"} returns HTTP 422: \texttt{"Input should be 'user' or 'recruiter'"}.
\end{tcolorbox}

\begin{tcolorbox}[colback=green!5, colframe=green!60!black, title=\textbf{PASS: Account Enumeration Eliminated}]
\texttt{POST /api/auth/forgot-password} returns identical error \texttt{"Invalid email or TOTP token"} for both existing and non-existing email addresses.
\end{tcolorbox}

\begin{tcolorbox}[colback=green!5, colframe=green!60!black, title=\textbf{PASS: OpenAPI Schema Blocked}]
\texttt{GET /openapi.json} returns HTTP 404 (blocked at both FastAPI and nginx levels). \texttt{/docs} and \texttt{/redoc} serve the React SPA shell, not API documentation.
\end{tcolorbox}

\begin{tcolorbox}[colback=green!5, colframe=green!60!black, title=\textbf{PASS: LAN-Only Access Restriction}]
Nginx configured with \texttt{allow 192.168.3.0/24; deny all;} restricting access to IIIT Delhi campus network only.
\end{tcolorbox}

\subsection{Security Headers}
\begin{tcolorbox}[colback=green!5, colframe=green!60!black, title=\textbf{PASS: Security Headers Present}]
\begin{itemize}[nosep]
  \item \texttt{X-Content-Type-Options: nosniff} \checkmark
  \item \texttt{X-Frame-Options: DENY} \checkmark
  \item \texttt{Strict-Transport-Security: max-age=31536000; includeSubDomains} \checkmark
  \item \texttt{server\_tokens off} — version hidden \checkmark
\end{itemize}
\end{tcolorbox}

