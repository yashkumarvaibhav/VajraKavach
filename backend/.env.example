# === VajraKavach Backend Configuration ===

# Database
DATABASE_URL=postgresql+asyncpg://vajrakavach:changeme@localhost:5432/vajrakavach_db

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (Fernet key — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_SECRET_KEY=your-fernet-key-here

# TOTP
TOTP_ISSUER=VajraKavach

# PKI
PKI_PRIVATE_KEY_PATH=certs/server.key
PKI_CERTIFICATE_PATH=certs/server.crt

# App
APP_TITLE=VajraKavach
APP_VERSION=0.1.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
UPLOAD_DIR=uploads
DEBUG=true
